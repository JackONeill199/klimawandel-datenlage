{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klimawandel-datenlage",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATA_CACHE_SECONDS": "21600"
  }
}
